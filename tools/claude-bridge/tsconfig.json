{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // The server runs under `node --experimental-strip-types`: imports name their .ts files, and no TS-only syntax.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src", "vitest.config.ts"]
}
