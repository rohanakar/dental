# Caddy: serves the SPA and proxies /api/* to the API container.
# Plain HTTP on :80; Nginx Proxy Manager in front handles the domain and TLS.
#
# Environment (set by docker-compose.yml from the repo-root .env):
#   BASE_PATH     "" at the domain root (default), or a sub-path like "/dental".
#                 The prefix is stripped before proxying, so the API always
#                 serves /api/* and the SPA's files live at the root of /srv.

{
	admin off
	servers {
		# Accept X-Forwarded-* from Nginx Proxy Manager on the shared Docker network.
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# "/dental" -> "/dental/" (only when a sub-path is configured).
	@bare expression `{path} == "{$BASE_PATH}" && "{$BASE_PATH}" != ""`
	redir @bare {$BASE_PATH}/ 308

	handle_path {$BASE_PATH}/* {
		handle /api/* {
			reverse_proxy api:3000 {
				# Scan uploads are streamed; don't buffer them.
				flush_interval -1
			}
		}

		# The editor lives at /app/; the landing page is the site root.
		redir /app {$BASE_PATH}/app/ 308
		# The margin algorithm, a static page (apps/web/public/algorithm/).
		redir /algorithm {$BASE_PATH}/algorithm/ 308

		handle {
			root * /srv
			@assets path /assets/*
			header @assets Cache-Control "public, max-age=31536000, immutable"
			@html not path /assets/*
			header @html Cache-Control "no-cache"
			# Unknown paths under /app/ belong to the editor, everything else to the landing page.
			@editor {
				path /app/*
				not file
			}
			rewrite @editor /app/index.html
			# {path}index.html serves a static page's index at its trailing-slash URL (/algorithm/);
			# try_files {path} alone never matches a directory, so that would fall through to the landing page.
			try_files {path} {path}index.html /index.html
			file_server
		}
	}

	handle {
		respond "Not found" 404
	}
}
