# Single config file for the whole repo. Copy to `.env` (gitignored) and fill in.
# Used by: `pnpm dev:api` (apps/api reads ../../.env) and `./infra/compose.sh`
# (Docker Compose interpolation + the api container's environment).
# Empty values count as unset. Don't put comments on the same line as a value.

# ---------------------------------------------------------------------------
# Public location
# ---------------------------------------------------------------------------
# Where browsers reach the app: origin + optional sub-path.
# Production (primary): https://dental.cognifuze.com
# Sub-path example:      https://example.com/dental
# Local dev with Vite:   http://localhost:5173
PUBLIC_URL=https://dental.cognifuze.com

# Derived from PUBLIC_URL by infra/compose.sh; set only to override.
# BASE_PATH is "" at the root or "/dental"; VITE_BASE_PATH is "/" or "/dental/".
BASE_PATH=
VITE_BASE_PATH=

# ---------------------------------------------------------------------------
# Our Caddy reverse proxy (infra/docker-compose.yml)
# ---------------------------------------------------------------------------
# Default mode: plain HTTP on the VM's loopback, behind your existing HTTPS proxy
# (nginx forwards dental.cognifuze.com -> 127.0.0.1:8080).
HTTP_BIND=127.0.0.1:8080
SITE_ADDRESS=:80
# TLS mode (Caddy owns ports 80/443 and gets certificates itself):
#   SITE_ADDRESS=dental.cognifuze.com
#   ./infra/compose.sh -f infra/docker-compose.tls.yml up -d --build

# ---------------------------------------------------------------------------
# Database (Postgres container)
# ---------------------------------------------------------------------------
POSTGRES_USER=dcad
# openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dcad
# Only for `pnpm dev:api` on the host (compose overrides it inside the stack).
# Start a local db: ./infra/compose.sh -f infra/docker-compose.dev.yml up -d db
DATABASE_URL=postgres://dcad:change-me@127.0.0.1:5432/dcad
MIGRATE_ON_START=true

# ---------------------------------------------------------------------------
# Auth (Better Auth, tables in our Postgres)
# ---------------------------------------------------------------------------
# openssl rand -base64 48   (min 32 chars)
AUTH_SECRET=
# Extra allowed browser origins, comma separated. Dev only, e.g. http://localhost:5173
TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# fs = Docker volume on the VM (default); s3 = any S3-compatible store.
BLOB_DRIVER=fs
# Host path for `pnpm dev:api` (relative to apps/api); compose uses /data/blobs.
BLOB_FS_ROOT=./data/blobs
# For BLOB_DRIVER=s3, e.g. OCI Object Storage S3 compatibility:
#   S3_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
#   S3_REGION=<region, e.g. ap-mumbai-1>
#   S3_BUCKET=dcad-blobs
#   S3_ACCESS_KEY_ID=<customer secret key id>
#   S3_SECRET_ACCESS_KEY=<customer secret key>
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# 200 MB
MAX_UPLOAD_BYTES=209715200

# ---------------------------------------------------------------------------
# LLM (server-side keys only; never exposed to the browser)
# ---------------------------------------------------------------------------
# Provider per purpose: explicit LLM_*_PROVIDER wins; otherwise anthropic if
# ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai | mock
LLM_AGENT_PROVIDER=
# Defaults: claude-sonnet-5 (anthropic), gpt-5 (openai)
LLM_AGENT_MODEL=
LLM_RX_PROVIDER=
LLM_RX_MODEL=
# Optional comma-separated allowlist the configured models must belong to.
LLM_MODEL_ALLOWLIST=
LLM_RATE_LIMIT_PER_MIN=30

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=info
