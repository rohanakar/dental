# Copy to .env (gitignored) and fill in. Used by ./infra/compose.sh and `pnpm dev:api`.
# Empty values count as unset. No comments on the same line as a value.

# Where browsers reach the app (the domain Nginx Proxy Manager serves).
PUBLIC_URL=https://dental.cognifuze.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
AUTH_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Local dev only (`pnpm dev:api` on the host; Compose sets its own inside the stack):
# Optional: defaults to postgres://dcad:${POSTGRES_PASSWORD}@127.0.0.1:5432/dcad. The API expands ${NAME}
# references itself (URL-encoded), so don't paste the password here.
# DATABASE_URL=postgres://dcad:${POSTGRES_PASSWORD}@127.0.0.1:5432/dcad
# TRUSTED_ORIGINS=http://localhost:5173

# Optional; defaults are in apps/api/src/config.ts. S3 storage: see infra/README.md.
# BLOB_DRIVER=fs
# MAX_UPLOAD_BYTES=209715200
# LLM_AGENT_PROVIDER=
# LLM_AGENT_MODEL=
# LLM_RX_PROVIDER=
# LLM_RX_MODEL=
# LOG_LEVEL=info

# Nightly backups (backup service; defaults shown). BACKUP_DIR is a host path outside the checkout.
# BACKUP_DIR=/var/backups/dcad
# BACKUP_HOUR=3
# BACKUP_KEEP_DAYS=14
# BACKUP_RUN_ON_START=0
